<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>스마트 배드민턴 매칭 & 랭킹</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-900 flex items-center justify-center p-0 sm:p-4 font-sans">

  <!-- 모바일 기기 프레임 컨테이너 -->
  <div class="w-full max-w-md bg-white sm:rounded-[40px] shadow-2xl overflow-hidden border border-gray-100 flex flex-col h-screen sm:h-[90vh] max-h-[900px] relative">

    <% if (!currentUser || currentView === 'auth') { %>
      <!-- 1. 로그인 / 회원가입 화면 -->
      <div class="flex flex-col h-full">
        <div class="bg-gradient-to-r from-slate-800 to-slate-900 p-5 text-white flex justify-between items-center shrink-0">
          <div>
            <span class="text-xs text-emerald-400 font-semibold">스마트 배드민턴 매칭</span>
            <h1 class="text-xl font-bold mt-0.5">계정 인증</h1>
          </div>
          <% if (currentUser) { %>
            <a href="/?tab=courts" class="bg-white/20 p-2 rounded-xl text-white">✕</a>
          <% } %>
        </div>

        <div class="flex border-b border-gray-200 bg-gray-100 shrink-0">
          <a href="/?view=auth&authTab=login" class="flex-1 py-3 text-xs font-bold text-center border-b-2 transition-all <%= authTab === 'login' ? 'border-emerald-600 text-emerald-600 bg-white' : 'border-transparent text-gray-500' %>">로그인</a>
          <a href="/?view=auth&authTab=signup" class="flex-1 py-3 text-xs font-bold text-center border-b-2 transition-all <%= authTab === 'signup' ? 'border-emerald-600 text-emerald-600 bg-white' : 'border-transparent text-gray-500' %>">회원가입</a>
        </div>

        <div class="p-5 overflow-y-auto space-y-4 flex-1">
          <% if (authTab === 'login') { %>
            <form action="/auth/login" method="POST" class="bg-white p-5 rounded-2xl border border-gray-200 space-y-4 shadow-sm">
              <h3 class="text-sm font-bold text-gray-800">🔑 계정 로그인</h3>
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">아이디</label>
                <input type="text" name="username" required placeholder="아이디 입력" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-xs">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">비밀번호</label>
                <input type="password" name="password" required placeholder="비밀번호 입력" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-xs">
              </div>
              <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl text-xs shadow transition-all mt-2">로그인하기</button>
            </form>
          <% } else { %>
            <form action="/auth/signup" method="POST" class="bg-white p-5 rounded-2xl border border-gray-200 space-y-3 shadow-sm">
              <h3 class="text-sm font-bold text-gray-800">✨ 신규 회원가입</h3>
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">아이디</label>
                <input type="text" name="username" required placeholder="아이디 입력" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2 text-xs">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">비밀번호</label>
                <input type="password" name="password" required placeholder="비밀번호 입력" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2 text-xs">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">이름 (실명)</label>
                <input type="text" name="name" required placeholder="실명 입력" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2 text-xs">
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1">나이</label>
                  <input type="number" name="age" required placeholder="나이" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2 text-xs">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1">성별</label>
                  <select name="gender" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2 text-xs">
                    <option value="남">남</option>
                    <option value="여">여</option>
                  </select>
                </div>
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">당근 닉네임</label>
                <input type="text" name="carrot_nickname" required placeholder="당근마켓 닉네임" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2 text-xs">
              </div>
              <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl text-xs shadow transition-all mt-2">회원가입 완료</button>
            </form>
          <% } %>
        </div>
      </div>

    <% } else if (currentView === 'main') { %>

      <!-- 모바일 상단 헤더 -->
      <div class="bg-gradient-to-r from-emerald-600 to-teal-700 px-5 py-4 text-white flex justify-between items-center shrink-0 shadow-md z-10">
        <div>
          <span class="text-[11px] text-emerald-100 font-semibold uppercase tracking-wider block">실시간 매칭 시스템</span>
          <h1 class="text-lg font-bold mt-0.5">스마트 배드민턴</h1>
        </div>
        <div class="shrink-0 flex items-center gap-2">
          <span class="text-xs bg-white/20 px-2.5 py-1 rounded-full font-medium whitespace-nowrap"><%= currentUser.name %>님</span>
          <a href="/auth/logout" class="text-[11px] bg-white/10 hover:bg-white/25 px-2 py-1 rounded-lg transition whitespace-nowrap">로그아웃</a>
        </div>
      </div>

      <!-- 본문 스크롤 영역 -->
      <div class="p-5 overflow-y-auto space-y-4 flex-1 pb-20">

        <!-- 1. 코트 현황 & 관리자 주도 출석부 및 현장 게스트 관리 탭 -->
        <% if (activeTab === 'courts') { %>
          <div class="space-y-5">
            <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-2xl flex justify-between items-center shadow-sm">
              <div>
                <h2 class="text-sm font-bold text-emerald-900">🏸 코트 및 현장 매칭 관리</h2>
                <p class="text-[11px] text-emerald-700 mt-0.5">대기 인원을 스마트하게 자동 배치합니다.</p>
              </div>
              <!-- 백엔드 연동 코트 수 조절 폼 -->
              <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-emerald-300 shadow-sm shrink-0">
                <span class="text-xs font-bold text-gray-700 whitespace-nowrap">코트: <span class="text-emerald-600"><%= courts.length %></span>개</span>
                <div class="flex gap-1 ml-1">
                  <form action="/courts/remove" method="POST" class="inline">
                    <button type="submit" class="w-6 h-6 bg-gray-100 hover:bg-gray-200 rounded-lg text-xs font-bold text-gray-700 flex items-center justify-center">-</button>
                  </form>
                  <form action="/courts/add" method="POST" class="inline">
                    <button type="submit" class="w-6 h-6 bg-emerald-600 hover:bg-emerald-700 rounded-lg text-xs font-bold text-white flex items-center justify-center">+</button>
                  </form>
                </div>
              </div>
            </div>

            <!-- 관리자 주도형 출석부 및 현장 게스트 등록 섹션 (마스터/관리자 전용 제어) -->
            <% if (currentUser.role === 'master' || currentUser.role === 'admin') { %>
              <div class="bg-amber-50 border border-amber-200 p-4 rounded-2xl space-y-3 shadow-sm">
                <h3 class="text-xs font-bold text-amber-900">🛡️ 관리자 출석부 및 현장 게스트 등록</h3>
                
                <!-- 현장 게스트 즉시 등록 폼 -->
                <form action="/admin/add-guest" method="POST" class="grid grid-cols-3 gap-2 bg-white p-3 rounded-xl border border-amber-200">
                  <input type="text" name="name" required placeholder="게스트 이름" class="bg-gray-50 border border-gray-200 rounded-lg px-2 py-1.5 text-xs">
                  <input type="number" name="age" required placeholder="나이" class="bg-gray-50 border border-gray-200 rounded-lg px-2 py-1.5 text-xs">
                  <select name="gender" class="bg-gray-50 border border-gray-200 rounded-lg px-2 py-1.5 text-xs">
                    <option value="남">남</option>
                    <option value="여">여</option>
                  </select>
                  <button type="submit" class="col-span-3 bg-amber-600 hover:bg-amber-700 text-white font-bold py-2 rounded-lg text-xs transition whitespace-nowrap">
                    + 현장 게스트 등록 및 출석 처리
                  </button>
                </form>

                <!-- 전체 회원 출석 체크 토글 리스트 (3열 고정 그리드 및 줄바꿈 방지) -->
                <div class="bg-white p-3 rounded-xl border border-amber-200 space-y-2">
                  <span class="text-[11px] font-bold text-gray-700 block mb-1">회원별 출석부 토글 관리 (3열 그리드)</span>
                  <div class="max-h-52 overflow-y-auto" id="attendance-scroll">
                    <% if (allUsers && allUsers.length > 0) { %>
                      <div class="grid grid-cols-3 gap-1.5">
                        <% allUsers.forEach(u => { %>
                          <% const isAttending = joinedParticipantIds.includes(u.id); %>
                          <div class="flex flex-col justify-between items-center text-xs bg-gray-50 p-2 rounded-lg border border-gray-100 text-center overflow-hidden">
                            <div class="w-full truncate">
                              <span class="font-bold text-gray-800 block truncate w-full"><%= u.name %></span>
                              <span class="text-[9px] text-gray-400 whitespace-nowrap">MMR: <%= u.mmr %></span>
                            </div>
                            <form action="/admin/participants/toggle" method="POST" class="mt-1 w-full" onsubmit="saveScrollPosition()">
                              <input type="hidden" name="user_id" value="<%= u.id %>">
                              <% if (isAttending) { %>
                                <input type="hidden" name="attended" value="0">
                                <button type="submit" class="w-full bg-red-100 text-red-600 py-1 rounded text-[9px] font-bold hover:bg-red-200 transition whitespace-nowrap">퇴장</button>
                              <% } else { %>
                                <input type="hidden" name="attended" value="1">
                                <button type="submit" class="w-full bg-emerald-100 text-emerald-700 py-1 rounded text-[9px] font-bold hover:bg-emerald-200 transition whitespace-nowrap">출석</button>
                              <% } %>
                            </form>
                          </div>
                        <% }) %>
                      </div>
                    <% } %>
                  </div>
                </div>

                <!-- 출석 및 대기 인원 중 듀오 지정/취소 섹션 (실제 출석 인원과 완벽 동기화) -->
                <div class="bg-white p-3 rounded-xl border border-amber-200 space-y-2">
                  <h4 class="text-[11px] font-bold text-amber-900">🔗 출석 및 대기 인원 듀오 지정 / 해제 (3경기 카운트)</h4>
                  <p class="text-[10px] text-gray-500">두 명을 체크하면 자동으로 듀오가 등록되며, 이미 듀오인 회원은 '듀오 해제' 버튼으로 언제든 해제할 수 있습니다.</p>
                  
                  <form id="duo-sync-form" action="/admin/sync-duo" method="POST" class="space-y-2">
                    <div class="max-h-36 overflow-y-auto space-y-1.5 border border-gray-100 p-2 rounded-lg bg-gray-50" id="duo-scroll">
                      <% if (members && members.length > 0) { %>
                        <% members.forEach(m => { %>
                          <label class="flex items-center justify-between text-xs bg-white p-2 rounded border border-gray-100 cursor-pointer hover:bg-gray-50 truncate" data-user-id="<%= m.id %>">
                            <span class="font-bold text-gray-800 truncate pr-2 flex items-center min-w-0">
                              <span class="truncate"><%= m.name %></span>
                              <span class="text-[10px] text-gray-400 font-normal whitespace-nowrap shrink-0 ml-1">
                                (MMR: <%= m.mmr %><%= m.duoGamesRemaining > 0 ? ' · ' + m.duoLabel + ' 활성(' + m.duoGamesRemaining + '경기)' : '' %>)
                              </span>
                            </span>
                            
                            <div class="flex items-center gap-2 shrink-0">
                              <% if (m.duoGamesRemaining > 0) { %>
                                <button type="button" onclick="removeDuo('<%= m.id %>')" class="text-[10px] bg-red-100 text-red-600 px-2 py-0.5 rounded font-bold hover:bg-red-200 transition whitespace-nowrap">듀오 해제</button>
                                <input type="hidden" name="user_ids" value="<%= m.id %>">
                                <input type="checkbox" checked disabled class="rounded bg-gray-200 border-gray-300 text-gray-400 cursor-not-allowed w-4 h-4">
                              <% } else { %>
                                <input type="checkbox" name="user_ids" value="<%= m.id %>" onchange="handleDuoChange(this)" class="rounded text-amber-600 focus:ring-amber-500 w-4 h-4">
                              <% } %>
                            </div>
                          </label>
                        <% }) %>
                      <% } else { %>
                        <p class="text-[11px] text-gray-400 text-center py-2">출석한 인원이 없습니다.</p>
                      <% } %>
                    </div>
                  </form>
                </div>
              </div>
            <% } %>

            <!-- 오늘 출석 및 대기 인원 현황 (코트 입장 인원 자동 숨김 처리 적용) -->
            <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-sm space-y-3">
              <div class="flex justify-between items-center mb-2">
                <h3 class="text-xs font-bold text-gray-700">👥 오늘 출석 및 대기 인원 (<%= members.length %>명)</h3>
              </div>
              <div class="flex flex-wrap gap-2 max-h-40 overflow-y-auto" id="waiting-members-container">
                <% if (members && members.length > 0) { %>
                  <% members.forEach(m => { %>
                    <span class="waiting-member-badge text-[11px] font-medium bg-emerald-50 border border-emerald-200 text-emerald-800 px-2.5 py-1 rounded-full flex items-center gap-1 whitespace-nowrap" data-member-name="<%= m.name %>">
                      <span class="truncate"><%= m.name %></span>
                      <span class="text-[9px] bg-white text-emerald-600 px-1 rounded-full shrink-0"><%= m.mmr %></span>
                      <% if (m.duoGamesRemaining > 0) { %>
                        <span class="text-[9px] bg-amber-500 text-white px-1 rounded-full shrink-0 whitespace-nowrap"><%= m.duoLabel %>(<%= m.duoGamesRemaining %>경기)</span>
                      <% } %>
                    </span>
                  <% }) %>
                <% } else { %>
                  <p class="text-xs text-gray-400 w-full text-center py-2">현재 대기 중인 인원이 없습니다.</p>
                <% } %>
              </div>
            </div>

            <!-- 백엔드 기반 코트 목록 렌더링 -->
            <div class="space-y-3" id="courts-container">
              <% if (courts && courts.length > 0) { %>
                <% courts.forEach(court => { %>
                  <div class="court-card p-4 rounded-2xl border bg-white border-emerald-200 shadow-sm space-y-3" 
                       data-status="<%= court.status %>"
                       data-ta-p1="<%= court.teamA_p1 %>" data-ta-p2="<%= court.teamA_p2 %>"
                       data-tb-p1="<%= court.teamB_p1 %>" data-tb-p2="<%= court.teamB_p2 %>">
                    <div class="flex justify-between items-center">
                      <span class="font-bold text-gray-800 text-sm whitespace-nowrap"><%= court.name %></span>
                      <% if (court.status === 'empty') { %>
                        <span class="text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-amber-100 text-amber-700 whitespace-nowrap">⚡ 대기 / 여유</span>
                      <% } else { %>
                        <span class="text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-red-100 text-red-700 whitespace-nowrap">🔥 경기 진행중</span>
                      <% } %>
                    </div>
                    
                    <% if (court.status === 'empty') { %>
                      <div class="bg-gray-50 p-4 rounded-xl text-center">
                        <p class="text-xs text-gray-500 mb-3">현재 비어있는 코트입니다.</p>
                        <form action="/courts/<%= court.id %>/assign" method="POST">
                          <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded-xl text-xs shadow transition-all whitespace-nowrap">
                            ✨ 스마트 대기조 자동 투입
                          </button>
                        </form>
                      </div>
                    <% } else { %>
                      <div class="bg-gray-50 p-3 rounded-xl text-xs space-y-2">
                        <div class="flex items-center justify-between gap-2">
                          <div class="flex-1 bg-white p-2 rounded-xl border border-emerald-200 text-center shadow-sm relative overflow-hidden">
                            <div class="text-[11px] font-bold text-emerald-700 mb-1">팀 A</div>
                            <div class="text-xs font-bold text-gray-800 flex items-center justify-center gap-1 truncate court-player" data-player-name="<%= court.teamA_p1 %>">
                              <span class="truncate"><%= court.teamA_p1 %></span>
                              <span class="text-[9px] text-gray-400 font-normal shrink-0">(<%= court.pA1_mmr %>)</span>
                            </div>
                            <div class="text-xs font-bold text-gray-800 flex items-center justify-center gap-1 truncate court-player" data-player-name="<%= court.teamA_p2 %>">
                              <span class="truncate"><%= court.teamA_p2 %></span>
                              <span class="text-[9px] text-gray-400 font-normal shrink-0">(<%= court.pA2_mmr %>)</span>
                            </div>
                            <div class="mt-1 pt-1 border-t border-gray-100 text-[10px] text-emerald-600 font-bold whitespace-nowrap">평균 MMR: <%= court.teamA_avgMmr %></div>
                          </div>

                          <div class="shrink-0 font-black text-sm text-gray-400 px-1">VS</div>

                          <div class="flex-1 bg-white p-2 rounded-xl border border-teal-200 text-center shadow-sm relative overflow-hidden">
                            <div class="text-[11px] font-bold text-teal-700 mb-1">팀 B</div>
                            <div class="text-xs font-bold text-gray-800 flex items-center justify-center gap-1 truncate court-player" data-player-name="<%= court.teamB_p1 %>">
                              <span class="truncate"><%= court.teamB_p1 %></span>
                              <span class="text-[9px] text-gray-400 font-normal shrink-0">(<%= court.pB1_mmr %>)</span>
                            </div>
                            <div class="text-xs font-bold text-gray-800 flex items-center justify-center gap-1 truncate court-player" data-player-name="<%= court.teamB_p2 %>">
                              <span class="truncate"><%= court.teamB_p2 %></span>
                              <span class="text-[9px] text-gray-400 font-normal shrink-0">(<%= court.pB2_mmr %>)</span>
                            </div>
                            <div class="mt-1 pt-1 border-t border-gray-100 text-[10px] text-teal-600 font-bold whitespace-nowrap">평균 MMR: <%= court.teamB_avgMmr %></div>
                          </div>
                        </div>
                      </div>

                      <!-- 점수 기입 및 경기 종료 폼 (점수 입력 중 날아가는 현상 방지) -->
                      <form action="/courts/<%= court.id %>/score" method="POST" class="grid grid-cols-2 gap-1.5 mt-2">
                        <input type="number" name="teamA_score" required placeholder="팀A 점수" class="bg-gray-50 border border-gray-200 rounded-xl px-2 py-1.5 text-xs text-center">
                        <input type="number" name="teamB_score" required placeholder="팀B 점수" class="bg-gray-50 border border-gray-200 rounded-xl px-2 py-1.5 text-xs text-center">
                        <button type="submit" class="col-span-2 bg-slate-800 hover:bg-black text-white font-bold py-2 rounded-xl text-xs shadow transition-all mt-1 whitespace-nowrap">
                          경기 종료 및 점수/MMR 반영
                        </button>
                      </form>
                    <% } %>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        <% } %>

        <!-- 2. 랭킹 및 기록 탭 -->
        <% if (activeTab === 'ranking') { %>
          <div class="space-y-6">
            <div class="space-y-2.5">
              <div class="flex justify-between items-center mb-1">
                <span class="text-xs text-gray-500 whitespace-nowrap">🏅 실시간 MMR 및 승패 순위</span>
              </div>
              <% if (rankingList && rankingList.length > 0) { %>
                <% rankingList.slice(0,10).forEach(user => { %>
                  <div class="bg-white p-3.5 rounded-2xl border border-gray-100 flex items-center justify-between shadow-sm">
                    <div class="flex items-center space-x-3 overflow-hidden pr-2 min-w-0 flex-1">
                      <span class="w-7 h-7 rounded-xl flex items-center justify-center text-xs font-bold shrink-0 <%= user.rank <= 3 ? 'bg-amber-100 text-amber-700' : 'bg-gray-100 text-gray-700' %>"><%= user.rank %></span>
                      <div class="truncate min-w-0 flex-1">
                        <h3 class="font-bold text-gray-800 text-sm truncate"><%= user.name %> <span class="text-[11px] font-normal text-gray-400 whitespace-nowrap">(<%= user.age %>세 / <%= user.gender %>)</span></h3>
                        <p class="text-[11px] text-gray-400 whitespace-nowrap"><%= user.wins %>승 <%= user.losses %>패 (<%= user.winRate %>%)</p>
                      </div>
                    </div>
                    <div class="text-right shrink-0">
                      <span class="text-xs font-bold text-emerald-600 whitespace-nowrap"><%= user.mmr %> 점</span>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-center py-6 text-gray-400 text-xs">등록된 데이터가 없습니다.</div>
              <% } %>
            </div>
            
            <hr class="border-gray-200">

            <div class="space-y-2.5">
              <div class="flex justify-between items-center mb-1">
                <span class="text-xs font-bold text-gray-800 whitespace-nowrap">📅 전체 경기 기록실</span>
                <form action="/" method="GET" class="flex gap-1 shrink-0">
                  <input type="hidden" name="tab" value="ranking">
                  <input type="date" name="matchDate" value="<%= matchDateQuery || '' %>" class="text-[10px] border border-gray-200 rounded px-1 py-0.5">
                  <button type="submit" class="text-[10px] bg-gray-200 px-2 py-0.5 rounded whitespace-nowrap">검색</button>
                </form>
              </div>
              
              <% if (allMatches && allMatches.length > 0) { %>
                <% allMatches.forEach(match => { %>
                  <div class="bg-gray-50 p-3 rounded-xl border border-gray-200 shadow-sm text-xs">
                    <div class="text-[10px] text-gray-400 mb-1 whitespace-nowrap"><%= new Date(match.playedAt).toLocaleString() %></div>
                    <div class="flex justify-between items-center text-center">
                      <div class="flex-1 truncate <%= match.winner === 'A' ? 'font-bold text-emerald-700' : 'text-gray-500' %> min-w-0 px-1">
                        <span class="truncate block"><%= match.teamA_p1 %></span>
                        <span class="truncate block"><%= match.teamA_p2 %></span>
                        <span class="text-lg whitespace-nowrap"><%= match.teamA_score %></span>
                      </div>
                      <div class="px-2 text-gray-300 font-black shrink-0">VS</div>
                      <div class="flex-1 truncate <%= match.winner === 'B' ? 'font-bold text-emerald-700' : 'text-gray-500' %> min-w-0 px-1">
                        <span class="truncate block"><%= match.teamB_p1 %></span>
                        <span class="truncate block"><%= match.teamB_p2 %></span>
                        <span class="text-lg whitespace-nowrap"><%= match.teamB_score %></span>
                      </div>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-center py-4 text-gray-400 text-xs">검색된 경기 기록이 없습니다.</div>
              <% } %>
            </div>
          </div>
        <% } %>

        <!-- 3. 내 프로필 탭 -->
        <% if (activeTab === 'profile') { %>
          <div class="space-y-5">
            <% if (currentUser) { %>
              <div class="bg-gradient-to-br from-emerald-500 to-teal-600 p-5 rounded-2xl text-white shadow-md space-y-4">
                <div class="flex justify-between items-start">
                  <div class="truncate pr-2 min-w-0 flex-1">
                    <span class="text-xs bg-white/20 px-2.5 py-0.5 rounded-full font-semibold whitespace-nowrap inline-block">
                      <% if (currentUser.role === 'master') { %>👑 마스터<% } else if (currentUser.role === 'admin') { %>🛡️ 관리자<% } else { %>🌱 일반회원<% } %>
                    </span>
                    <h2 class="text-base font-bold mt-2 truncate"><%= currentUser.name %> (<%= currentUser.age %>세 / <%= currentUser.gender %>)</h2>
                    <p class="text-xs text-emerald-100 mt-0.5 truncate">당근: <strong class="text-white"><%= currentUser.carrot_nickname %></strong></p>
                  </div>
                  <div class="text-right shrink-0">
                    <span class="text-xs text-emerald-100 whitespace-nowrap">현재 MMR</span>
                    <div class="text-2xl font-black mt-0.5 whitespace-nowrap"><%= myStats ? myStats.mmr : 1000 %> 점</div>
                    <div class="text-[10px] text-emerald-200 mt-1 whitespace-nowrap"><%= myStats ? myStats.wins : 0 %>승 <%= myStats ? myStats.losses : 0 %>패</div>
                  </div>
                </div>
              </div>

              <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-sm space-y-3">
                <h3 class="text-xs font-bold text-gray-700 whitespace-nowrap">🤝 듀오 파트너 승률 분석</h3>
                <% if (partnerStats && partnerStats.length > 0) { %>
                  <div class="space-y-2">
                    <% partnerStats.slice(0, 3).forEach((p, index) => { %>
                      <div class="flex justify-between items-center text-xs bg-gray-50 p-2 rounded-lg border border-gray-100">
                        <div class="font-bold text-gray-800 truncate pr-2 min-w-0 flex-1"><span class="text-amber-500 mr-1 whitespace-nowrap"><%= index + 1 %>위</span> <span class="truncate"><%= p.partner %></span></div>
                        <div class="text-gray-500 shrink-0 whitespace-nowrap"><%= p.wins %>승 <%= p.losses %>패 <span class="font-bold text-emerald-600 ml-1">(<%= p.winRate %>%)</span></div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <p class="text-[11px] text-gray-400">아직 함께 뛴 파트너 기록이 없습니다.</p>
                <% } %>
              </div>

              <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-sm space-y-3">
                <h3 class="text-xs font-bold text-gray-700 whitespace-nowrap">📝 나의 최근 경기 (최대 5건)</h3>
                <% if (myRecentMatches && myRecentMatches.length > 0) { %>
                  <div class="space-y-2">
                    <% myRecentMatches.forEach(match => { %>
                      <% 
                        const isTeamA = match.teamA_p1 === currentUser.name || match.teamA_p2 === currentUser.name;
                        const didIWin = (isTeamA && match.winner === 'A') || (!isTeamA && match.winner === 'B');
                      %>
                      <div class="flex justify-between items-center text-xs bg-gray-50 p-2.5 rounded-lg border border-gray-100">
                        <span class="font-bold <%= didIWin ? 'text-blue-600' : 'text-red-500' %> w-10 shrink-0 whitespace-nowrap"><%= didIWin ? '승리' : '패배' %></span>
                        <div class="flex-1 text-center text-[10px] text-gray-600 truncate px-1 min-w-0">
                          <span class="truncate"><%= match.teamA_p1 %></span>, <span class="truncate"><%= match.teamA_p2 %></span> 
                          <span class="font-bold text-gray-900 mx-1 whitespace-nowrap"><%= match.teamA_score %> : <%= match.teamB_score %></span> 
                          <span class="truncate"><%= match.teamB_p1 %></span>, <span class="truncate"><%= match.teamB_p2 %></span>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <p class="text-[11px] text-gray-400">참여한 경기 기록이 없습니다.</p>
                <% } %>
              </div>

              <% if (currentUser.role === 'master' || currentUser.role === 'admin') { %>
                <a href="/?view=member_management" class="w-full bg-slate-900 hover:bg-black text-white font-bold py-3 rounded-2xl text-xs shadow flex items-center justify-center gap-2 block text-center whitespace-nowrap">
                  ⚙️ 관리자 전용 설정 페이지
                </a>
              <% } %>
            <% } %>
          </div>
        <% } %>

      </div>

      <!-- 모바일 하단 네비게이션 바 -->
      <nav class="absolute bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-gray-200 px-4 py-2 flex justify-around items-center z-20 shadow-lg">
        <a href="/?tab=courts" class="flex flex-col items-center flex-1 py-1 <%= activeTab === 'courts' ? 'text-emerald-600 font-bold' : 'text-gray-400 hover:text-gray-600' %> transition">
          <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
          <span class="text-[10px] whitespace-nowrap">코트 현황</span>
        </a>
        <a href="/?tab=ranking" class="flex flex-col items-center flex-1 py-1 <%= activeTab === 'ranking' ? 'text-emerald-600 font-bold' : 'text-gray-400 hover:text-gray-600' %> transition">
          <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          <span class="text-[10px] whitespace-nowrap">랭킹/기록</span>
        </a>
        <a href="/?tab=profile" class="flex flex-col items-center flex-1 py-1 <%= activeTab === 'profile' ? 'text-emerald-600 font-bold' : 'text-gray-400 hover:text-gray-600' %> transition">
          <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          <span class="text-[10px] whitespace-nowrap">내 프로필</span>
        </a>
      </nav>

    <% } else if (currentView === 'member_management') { %>
      <!-- 관리자 전용 뷰 -->
      <div class="flex flex-col h-full">
        <div class="bg-gradient-to-r from-slate-900 to-slate-800 p-5 text-white flex justify-between items-center shrink-0">
          <div>
            <span class="text-xs text-amber-400 font-semibold">보안 권한 구역</span>
            <h1 class="text-xl font-bold">시스템 및 회원 관리</h1>
          </div>
          <a href="/?tab=profile" class="bg-white/20 p-2 rounded-xl text-white">✕</a>
        </div>

        <div class="p-4 overflow-y-auto space-y-5 flex-1">
          <div class="space-y-3">
            <div class="flex justify-between items-center px-1">
              <h2 class="text-sm font-bold text-gray-800 whitespace-nowrap">👥 전체 회원 목록 (<%= allUsers ? allUsers.length : 0 %>명)</h2>
              <% if (currentUser.role === 'master') { %>
                <form action="/admin/reset-all-mmr" method="POST" onsubmit="return confirm('정말 모든 데이터(MMR 및 경기 기록)를 초기화하시겠습니까?');">
                  <button type="submit" class="text-[10px] bg-red-100 text-red-600 px-2 py-1 rounded font-bold whitespace-nowrap">전체 데이터 초기화</button>
                </form>
              <% } %>
            </div>
            
            <div class="space-y-2.5">
              <% if (allUsers) { %>
                <% allUsers.forEach(u => { %>
                  <div class="bg-white p-3.5 rounded-2xl border border-gray-200 shadow-sm flex justify-between items-center">
                    <div class="truncate pr-2 min-w-0 flex-1">
                      <span class="font-bold text-gray-900 text-sm truncate inline-block"><%= u.name %></span>
                      <span class="text-[10px] bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded ml-1 whitespace-nowrap inline-block"><%= u.role %></span>
                      <div class="text-xs text-gray-500 mt-0.5 whitespace-nowrap">MMR: <span class="font-bold text-emerald-600"><%= u.mmr %></span></div>
                    </div>
                    
                    <% if (currentUser.role === 'master' && u.id !== currentUser.id) { %>
                      <form action="/admin/users/<%= u.id %>/role" method="POST" class="flex items-center gap-1 shrink-0">
                        <select name="role" class="text-[10px] border border-gray-200 rounded p-1">
                          <option value="member" <%= u.role === 'member' ? 'selected' : '' %>>일반</option>
                          <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>관리자</option>
                          <option value="master" <%= u.role === 'master' ? 'selected' : '' %>>마스터</option>
                        </select>
                        <button type="submit" class="text-[10px] bg-slate-800 text-white px-2 py-1 rounded whitespace-nowrap">변경</button>
                      </form>
                    <% } %>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const savedScroll = sessionStorage.getItem("mainScrollTop");
      if (savedScroll !== null) {
        const container = document.querySelector('.overflow-y-auto');
        if (container) {
          container.scrollTop = parseInt(savedScroll, 10);
        }
      }

      ['attendance-scroll', 'duo-scroll'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          const pos = sessionStorage.getItem(id + 'Top');
          if (pos !== null) {
            el.scrollTop = parseInt(pos, 10);
          }
        }
      });

      window.scrollTo(0, parseInt(sessionStorage.getItem("windowScrollY") || 0, 10));
      
      sessionStorage.removeItem("mainScrollTop");
      sessionStorage.removeItem("windowScrollY");
      sessionStorage.removeItem("attendance-scrollTop");
      sessionStorage.removeItem("duo-scrollTop");

      // 1. 듀오 지정 박스는 항상 모든 출석 인원 표시
      const duoForm = document.getElementById("duo-sync-form");
      if (duoForm) {
        duoForm.querySelectorAll("label").forEach(label => {
          label.style.display = "flex";
        });
      }

      // 2. 진행 중인 코트 인원 파악 후 일반 출석 인원 목록에서 숨기기 처리
      const playingNames = new Set();

      document.querySelectorAll(".court-card").forEach(card => {
        const status = card.getAttribute("data-status");
        if (status === "playing") {
          const p1 = card.getAttribute("data-ta-p1");
          const p2 = card.getAttribute("data-ta-p2");
          const p3 = card.getAttribute("data-tb-p1");
          const p4 = card.getAttribute("data-tb-p2");
          [p1, p2, p3, p4].forEach(name => {
            if (name && name !== "-") playingNames.add(name);
          });
        }
      });

      // 일반 출석부 대기 인원 목록 숨김 처리 (코트 참여 중인 인원 제외)
      document.querySelectorAll(".waiting-member-badge").forEach(badge => {
        const memberName = badge.getAttribute("data-member-name");
        if (playingNames.has(memberName)) {
          badge.style.display = "none";
        } else {
          badge.style.display = "flex";
        }
      });
    });

    function saveScrollPosition() {
      const container = document.querySelector('.overflow-y-auto');
      if (container) {
        sessionStorage.setItem("mainScrollTop", container.scrollTop);
      }
      ['attendance-scroll', 'duo-scroll'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          sessionStorage.setItem(id + 'Top', el.scrollTop);
        }
      });
      sessionStorage.setItem("windowScrollY", window.scrollY);
    }

    function handleDuoChange(checkbox) {
      const form = document.getElementById('duo-sync-form');
      if (!form) return;
      const checkboxes = form.querySelectorAll('input[type="checkbox"][name="user_ids"]:not(:disabled)');
      const checked = Array.from(checkboxes).filter(cb => cb.checked);
      
      if (checked.length === 2) {
        saveScrollPosition();
        form.submit();
      } else if (checked.length > 2) {
        alert("듀오는 최대 2명까지만 지정할 수 있습니다.");
        checkbox.checked = false;
      }
    }

    function removeDuo(userId) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/admin/remove-duo';
      
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'user_id';
      input.value = userId;
      
      form.appendChild(input);
      document.body.appendChild(form);
      
      saveScrollPosition();
      form.submit();
    }

    window.addEventListener("beforeunload", saveScrollPosition);

    document.addEventListener("click", (e) => {
      const target = e.target.closest("button, a, input[type='submit'], form");
      if (target) {
        saveScrollPosition();
      }
    });

    document.addEventListener("submit", saveScrollPosition);
  </script>
</body>
</html>
